{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/ora-manifest-0.1.json",
  "title": "Proposed ORA Manifest — v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "version", "status", "owner_scope", "oracle_interfaces", "capability_bundles", "runtime_targets", "offline_policy", "continuity", "admission"],
  "properties": {
    "schema": {"const": "ora.manifest/0.1"},
    "id": {"type": "string", "pattern": "^ora:[a-z0-9][a-z0-9.:_-]{3,127}$"},
    "name": {"type": "string", "minLength": 2, "maxLength": 100},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["PROPOSED", "SPECIFIED", "TESTING", "ADMITTED", "SUSPENDED", "SUPERSEDED", "REJECTED"]},
    "owner_scope": {"type": "string", "minLength": 1},
    "oracle_interfaces": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "capability_bundles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "runtime_targets": {"type": "array", "items": {"enum": ["android", "ios", "browser", "oracle_vm"]}, "uniqueItems": true},
    "offline_policy": {"enum": ["offline_full", "offline_limited", "hybrid", "online_required"]},
    "continuity": {"type": "object", "additionalProperties": false, "required": ["public_read", "event_heads", "default_max_negotiation_rounds"], "properties": {"public_read": {"type": "boolean"}, "event_heads": {"type": "array", "items": {"type": "string"}}, "default_max_negotiation_rounds": {"type": "integer", "minimum": 1, "maximum": 6}}},
    "admission": {"type": "object", "additionalProperties": false, "required": ["fixtures", "independent_reviewed", "allowed_effects"], "properties": {"fixtures": {"type": "array", "items": {"type": "string"}}, "independent_reviewed": {"type": "boolean"}, "allowed_effects": {"type": "array", "items": {"type": "string"}}}}
  }
}
